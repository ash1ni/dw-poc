# Export UDISE_PROJECT_DIR before starting Python or Airflow.
# Point UDISE_BRONZE_ROOT to your existing Bronze Parquet directory.
UDISE_BRONZE_ROOT=/absolute/path/to/udise_data/bronze

UDISE_SILVER_DB=udise_silver
UDISE_GOLD_DB=udise_gold

UDISE_MANAGEMENT_SOURCE_DB=udise_gold
UDISE_MANAGEMENT_SOURCE_TABLE=dim_management
UDISE_REFRESH_MANAGEMENT_DIM=0

SPARK_DRIVER_MEMORY=4g
SPARK_DRIVER_MAX_RESULT_SIZE=2g
SPARK_SHUFFLE_PARTITIONS=8
